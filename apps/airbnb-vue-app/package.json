{
  "name": "@airbnb-skripsi/vue-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/catalog.test.ts",
    "test:integration": "vitest run src/components/property-explorer.test.ts"
  },
  "dependencies": {
    "@airbnb-skripsi/api": "workspace:*",
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "latest"
  }
}
