{
  "name": "@airbnb-skripsi/react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3002",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3002",
    "start": "vite preview --host 0.0.0.0 --port 3002",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/catalog.test.ts",
    "test:integration": "vitest run src/components/property-explorer.test.tsx"
  },
  "dependencies": {
    "@airbnb-skripsi/api": "workspace:*",
    "@airbnb-skripsi/styles": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
