{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/svelte",
    "ultracite/biome/vue"
  ],
  "files": {
    "includes": ["!.agents", "!**/.agents", "!artifacts"]
  },
  "overrides": [
    {
      "includes": ["apps/airbnb-svelte-app/**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/airbnb-vue-app/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
