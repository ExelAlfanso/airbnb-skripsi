{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/svelte",
    "ultracite/biome/vue"
  ],
  "files": {
    "includes": ["!.agents", "!**/.agents"]
  },
  "overrides": [
    {
      "includes": ["apps/airbnb-svelte-app/**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/airbnb-vue-app/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/performance/k6/**/*.js"],
      "javascript": {
        "globals": ["__ENV"]
      }
    }
  ]
}
